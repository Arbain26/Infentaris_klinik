# ====================================================================
# KONFIGURASI SISTEM LAPORAN INVENTARIS & PENGELUARAN KLINIK
# Salin file ini menjadi .env dan sesuaikan nilainya
# ====================================================================

# Port Server Express (Default: 3000)
PORT=3000

# --------------------------------------------------------------------
# OPSIONAL 1: DATABASE MYSQL (Lokal / Self-Hosted / XAMPP)
# Jika kredensial Supabase di bawah dikosongkan, server otomatis memakai MySQL
# --------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_klinik_inventaris

# --------------------------------------------------------------------
# OPSIONAL 2: DATABASE SUPABASE CLOUD (PostgreSQL)
# Jika diisi, server akan otomatis beralih menggunakan Supabase Cloud
# --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

