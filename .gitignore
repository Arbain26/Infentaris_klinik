# ====================================================================
# 🛡️ KEAMANAN TINGKAT TINGGI: KREDENSIAL & ENVIRONMENT SENSITIF
# ====================================================================
# Jangan pernah commit file environment nyata
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.env
**/.env
**/.env.*
**/.env.local
**/.env.production

# Pengecualian hanya untuk template contoh kredensial
!.env.example
!backend/.env.example
!frontend/.env.example

# Kunci Kriptografi, SSL, TLS & SSH
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.csr
id_rsa*
id_ed25519*
known_hosts*

# Token, Kredensial Cloud & Secrets
credentials.json
client_secret*.json
*.secret
secrets.*

