{
  "name": "klinik-inventaris-monorepo",
  "version": "2.0.0",
  "description": "Sistem Laporan Inventaris & Pengeluaran/Pemasukan Klinik - NestJS + Next.js + Prisma",
  "private": true,
  "scripts": {
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start:prod --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "legacy:start": "node server.js"
  },
  "keywords": [
    "klinik",
    "inventaris",
    "laporan",
    "keuangan",
    "nestjs",
    "prisma",
    "nextjs",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "mysql2": "^3.12.0",
    "pdf-parse": "^2.4.5"
  }
}
